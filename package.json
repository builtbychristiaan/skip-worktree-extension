{
  "name": "skip-worktree",
  "displayName": "Skip Worktree",
  "description": "Skip or unskip tracked files with git update-index --skip-worktree, and manage all skipped files from the sidebar, status bar, or command palette.",
  "version": "0.3.0",
  "publisher": "christiaan-du-preez",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "skip-worktree",
    "source control",
    "scm",
    "local changes",
    "config"
  ],
  "galleryBanner": {
    "color": "#1e3a5f",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Christiaan-code/skip-worktree-extension"
  },
  "bugs": {
    "url": "https://github.com/Christiaan-code/skip-worktree-extension/issues"
  },
  "homepage": "https://github.com/Christiaan-code/skip-worktree-extension#readme",
  "contributes": {
    "commands": [
      {
        "command": "skipWorktree.skipFile",
        "title": "Skip File",
        "category": "Git Skip Worktree"
      },
      {
        "command": "skipWorktree.unskipFile",
        "title": "Unskip File",
        "category": "Git Skip Worktree"
      },
      {
        "command": "skipWorktree.showSkippedFiles",
        "title": "Show Skipped Files",
        "category": "Git Skip Worktree",
        "icon": "$(list-unordered)"
      },
      {
        "command": "skipWorktree.unskipAll",
        "title": "Unskip All Skipped Files",
        "category": "Git Skip Worktree",
        "icon": "$(close)"
      },
      {
        "command": "skipWorktree.refresh",
        "title": "Refresh",
        "category": "Git Skip Worktree",
        "icon": "$(refresh)"
      },
      {
        "command": "skipWorktree.openSkippedFile",
        "title": "Open File",
        "category": "Git Skip Worktree",
        "icon": "$(go-to-file)"
      },
      {
        "command": "skipWorktree.unskipFromTree",
        "title": "Unskip",
        "category": "Git Skip Worktree",
        "icon": "$(close)"
      },
      {
        "command": "skipWorktree.skipFromTree",
        "title": "Skip",
        "category": "Git Skip Worktree",
        "icon": "$(eye-closed)"
      },
      {
        "command": "skipWorktree.skipFromScm",
        "title": "Skip File",
        "category": "Git Skip Worktree",
        "icon": "$(eye-closed)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skipWorktree",
          "title": "Skip Worktree",
          "icon": "$(eye-closed)"
        }
      ]
    },
    "views": {
      "skipWorktree": [
        {
          "id": "skipWorktree.skippedFiles",
          "name": "Skipped Files",
          "when": "workspaceFolderCount != 0"
        },
        {
          "id": "skipWorktree.recentlySkippedFiles",
          "name": "Recently Skipped Files",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "skipWorktree.skippedFiles",
        "contents": "No files are currently marked with skip-worktree.\n\nRight-click a tracked file in the explorer and choose **Skip File**, or run **Git Skip Worktree: Show Skipped Files** from the command palette."
      },
      {
        "view": "skipWorktree.recentlySkippedFiles",
        "contents": "Previously skipped files that are no longer skipped will appear here."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "skipWorktree.skipFile",
          "when": "explorerResourceIsFolder == false",
          "group": "7_modification@1"
        },
        {
          "command": "skipWorktree.unskipFile",
          "when": "explorerResourceIsFolder == false",
          "group": "7_modification@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "skipWorktree.skipFromScm",
          "when": "scmProvider == git && scmResourceGroup == workingTree",
          "group": "inline@3"
        }
      ],
      "view/title": [
        {
          "command": "skipWorktree.refresh",
          "when": "view == skipWorktree.skippedFiles",
          "group": "navigation"
        },
        {
          "command": "skipWorktree.refresh",
          "when": "view == skipWorktree.recentlySkippedFiles",
          "group": "navigation"
        },
        {
          "command": "skipWorktree.showSkippedFiles",
          "when": "view == skipWorktree.skippedFiles",
          "group": "navigation"
        },
        {
          "command": "skipWorktree.unskipAll",
          "when": "view == skipWorktree.skippedFiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "skipWorktree.unskipFromTree",
          "when": "view == skipWorktree.skippedFiles && viewItem == skippedFile",
          "group": "inline@1"
        },
        {
          "command": "skipWorktree.skipFromTree",
          "when": "view == skipWorktree.recentlySkippedFiles && viewItem == recentlySkippedFile",
          "group": "inline@1"
        },
        {
          "command": "skipWorktree.openSkippedFile",
          "when": "view == skipWorktree.skippedFiles && viewItem == skippedFile",
          "group": "1_navigation@1"
        },
        {
          "command": "skipWorktree.unskipFromTree",
          "when": "view == skipWorktree.skippedFiles && viewItem == skippedFile",
          "group": "1_modification@1"
        },
        {
          "command": "skipWorktree.skipFromTree",
          "when": "view == skipWorktree.recentlySkippedFiles && viewItem == recentlySkippedFile",
          "group": "1_modification@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
